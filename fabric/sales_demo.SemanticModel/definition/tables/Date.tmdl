table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		dataType: string
		summarizeBy: none
		sortByColumn: 'Month Number'
		isNameInferred
		sourceColumn: [Month]

	partition Date = calculated
		mode: import
		source = ```
				ADDCOLUMNS(
					CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)),
					"Year", YEAR([Date]),
					"Month Number", MONTH([Date]),
					"Month", FORMAT([Date], "MMM")
				)
				```
